<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>نظام إدارة الصيدلية</title>
<style>
:root{--bg:#f4f7fb;--panel:#fff;--text:#182230;--muted:#718096;--line:#e4eaf1;--green:#087f70;--green2:#0b9b86;--soft:#e8f7f3;--red:#d9485f;--amber:#c47b12;--shadow:0 12px 34px rgba(25,45,75,.08)}
*{box-sizing:border-box}body{margin:0;font-family:Tahoma,Arial,sans-serif;background:var(--bg);color:var(--text)}button,input,select{font:inherit}button{cursor:pointer;border:0;border-radius:10px;padding:11px 15px;font-weight:700}.primary{background:var(--green);color:white}.primary:hover{background:#066b60}.secondary{background:#eef3f7;color:#344054}.danger{background:#fff0f1;color:var(--red)}.muted{color:var(--muted)}.hidden{display:none!important}
.login-wrap{min-height:100vh;display:grid;grid-template-columns:1.05fr .95fr;background:#fff}.login-side{padding:clamp(28px,5vw,72px);display:flex;flex-direction:column;justify-content:center;max-width:680px;width:100%;margin:auto}.brand{display:flex;align-items:center;gap:12px;margin-bottom:36px}.logo{width:52px;height:52px;border-radius:16px;background:var(--soft);color:var(--green);display:grid;place-items:center;font-size:28px;font-weight:900}.brand h1{font-size:22px;margin:0 0 5px}.brand p{margin:0;color:var(--muted);font-size:13px}.login-side h2{font-size:30px;margin:0 0 9px}.intro{color:var(--muted);line-height:1.8;margin:0 0 28px}.field{display:flex;flex-direction:column;gap:8px;margin-bottom:17px}.field label{font-weight:700;font-size:13px}.field input,.field select{width:100%;border:1px solid #dbe3ec;border-radius:11px;padding:14px;background:#fbfcfe;outline:none}.field input:focus,.field select:focus{border-color:var(--green2);box-shadow:0 0 0 3px #0b9b861a}.login-btn{width:100%;padding:14px;margin-top:6px}.login-error{color:var(--red);font-size:13px;margin:12px 0 0;min-height:18px}.credits{border-top:1px solid var(--line);margin-top:30px;padding-top:20px;line-height:1.9;font-size:12px;color:#596579}.credits strong{color:#263445}.hero{background:linear-gradient(145deg,#075e56,#0b8c7a 60%,#38b59d);color:white;display:flex;flex-direction:column;justify-content:space-between;padding:clamp(28px,5vw,64px);position:relative;overflow:hidden}.hero:before,.hero:after{content:"";position:absolute;border:1px solid #ffffff25;border-radius:50%;width:430px;height:430px;left:-120px;top:12%}.hero:after{width:300px;height:300px;left:-50px;top:22%}.hero-content{position:relative;z-index:1;margin:auto 0}.hero .eyebrow{letter-spacing:2px;text-transform:uppercase;font-size:12px;opacity:.8}.hero h2{font-size:clamp(30px,4vw,50px);line-height:1.35;max-width:520px;margin:20px 0}.hero p{line-height:2;max-width:470px;color:#e1f8f2}.feature-list{display:grid;gap:14px;margin-top:34px}.feature{display:flex;align-items:center;gap:12px}.feature span:first-child{width:35px;height:35px;border-radius:11px;background:#ffffff20;display:grid;place-items:center}.hero-foot{font-size:12px;opacity:.75;position:relative;z-index:1}
.app{min-height:100vh;display:grid;grid-template-columns:250px 1fr}.sidebar{background:#102b35;color:#dbe8ec;padding:22px 15px;display:flex;flex-direction:column;gap:22px}.side-brand{display:flex;align-items:center;gap:10px;padding:3px 8px 22px;border-bottom:1px solid #ffffff18}.side-brand .logo{width:42px;height:42px}.side-brand h2{font-size:15px;margin:0}.side-brand p{font-size:11px;color:#9db4bd;margin:5px 0 0}.nav-label{font-size:11px;color:#8ca5ae;padding:0 12px;margin-bottom:8px}.nav{display:grid;gap:5px}.nav button{background:transparent;color:#bfd0d6;text-align:right;display:flex;gap:12px;align-items:center;padding:12px;border-radius:10px;font-weight:500}.nav button.active,.nav button:hover{background:#ffffff14;color:#fff}.nav .ico{width:22px;text-align:center}.side-bottom{margin-top:auto;border-top:1px solid #ffffff18;padding-top:15px}.user-mini{display:flex;gap:10px;align-items:center;padding:8px}.avatar{width:36px;height:36px;border-radius:50%;background:#d7f4ec;color:#087f70;display:grid;place-items:center;font-weight:900}.user-mini strong{display:block;font-size:12px}.user-mini small{color:#9db4bd;font-size:10px}.main{min-width:0}.topbar{height:76px;background:#fff;border-bottom:1px solid var(--line);display:flex;align-items:center;justify-content:space-between;padding:0 30px;gap:16px}.top-title h1{font-size:20px;margin:0 0 5px}.top-title p{font-size:12px;color:var(--muted);margin:0}.top-actions{display:flex;align-items:center;gap:10px}.search{border:1px solid var(--line);border-radius:10px;padding:10px 12px;min-width:210px;outline:none}.content{padding:26px 30px;max-width:1600px;margin:auto}.page-head{display:flex;align-items:center;justify-content:space-between;gap:15px;margin-bottom:22px}.page-head h2{font-size:22px;margin:0 0 7px}.page-head p{margin:0;color:var(--muted);font-size:13px}.stats{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:16px;margin-bottom:22px}.stat,.panel{background:var(--panel);border:1px solid var(--line);border-radius:16px;box-shadow:0 3px 12px #18344c05}.stat{padding:19px}.stat-top{display:flex;justify-content:space-between;align-items:center;color:var(--muted);font-size:12px}.stat-icon{width:40px;height:40px;display:grid;place-items:center;border-radius:12px;background:var(--soft);color:var(--green);font-size:19px}.stat strong{display:block;font-size:27px;margin:14px 0 7px}.stat small{font-size:11px;color:var(--muted)}.stat .warn{color:var(--amber)}.stat .bad{color:var(--red)}.two-col{display:grid;grid-template-columns:1.35fr 1fr;gap:18px;margin-bottom:20px}.panel{padding:20px;min-width:0}.panel-head{display:flex;justify-content:space-between;align-items:center;gap:12px;margin-bottom:18px}.panel-head h3{font-size:15px;margin:0}.panel-head p{font-size:11px;color:var(--muted);margin:5px 0 0}.chart{height:190px;display:flex;align-items:end;justify-content:space-around;gap:12px;padding:8px 4px 0;border-bottom:1px solid var(--line);background:repeating-linear-gradient(to top,transparent 0,transparent 46px,#edf1f5 47px,#edf1f5 48px)}.bar-group{height:100%;flex:1;display:flex;flex-direction:column;align-items:center;justify-content:end;gap:8px;min-width:0}.bar{width:min(28px,75%);border-radius:7px 7px 2px 2px;background:linear-gradient(180deg,#29b7a0,#087f70);min-height:5px}.bar-label{font-size:10px;color:var(--muted);padding-bottom:9px}.alert-list{display:grid;gap:12px}.alert{display:flex;align-items:center;gap:11px;padding:12px;border-radius:12px;background:#fafbfd;border:1px solid var(--line)}.alert-icon{width:35px;height:35px;border-radius:10px;display:grid;place-items:center;background:#fff1db;color:var(--amber);flex-shrink:0}.alert-icon.red{background:#fff0f1;color:var(--red)}.alert-info{flex:1;min-width:0}.alert-info strong{font-size:12px;display:block;margin-bottom:5px}.alert-info small{font-size:11px;color:var(--muted)}.pill{display:inline-block;border-radius:99px;padding:5px 9px;font-size:10px;font-weight:700;background:#e7f7ef;color:#16794c}.pill.warn{background:#fff4dc;color:#a66a0a}.pill.bad{background:#ffebed;color:#c4374c}.table-wrap{overflow:auto}table{width:100%;border-collapse:collapse;white-space:nowrap}th{text-align:right;color:var(--muted);font-size:11px;font-weight:700;background:#f8fafc;padding:13px 12px;border-bottom:1px solid var(--line)}td{padding:14px 12px;font-size:12px;border-bottom:1px solid #edf1f5}tbody tr:hover{background:#fbfdfd}.product-cell{display:flex;align-items:center;gap:10px}.product-thumb{width:34px;height:34px;border-radius:10px;background:#edf8f5;color:var(--green);display:grid;place-items:center}.product-cell strong{display:block;font-size:12px}.product-cell small{color:var(--muted);font-size:10px}.toolbar{display:flex;gap:10px;align-items:center;flex-wrap:wrap;margin-bottom:16px}.toolbar input,.toolbar select{border:1px solid var(--line);border-radius:9px;padding:10px 12px;background:#fff;outline:none}.toolbar input{min-width:220px}.empty{text-align:center;padding:40px;color:var(--muted)}.form-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:0 16px}.modal-backdrop{position:fixed;inset:0;background:#0e202b70;display:grid;place-items:center;padding:20px;z-index:5}.modal{background:white;border-radius:18px;padding:24px;width:min(560px,100%);max-height:90vh;overflow:auto;box-shadow:var(--shadow)}.modal-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:20px}.modal-head h3{margin:0}.modal-actions{display:flex;justify-content:flex-start;gap:9px;margin-top:12px}.toast{position:fixed;bottom:24px;left:24px;background:#123b36;color:white;padding:13px 18px;border-radius:12px;box-shadow:var(--shadow);z-index:10}.mobile-menu{display:none}
@media(max-width:1050px){.app{grid-template-columns:215px 1fr}.stats{grid-template-columns:repeat(2,minmax(0,1fr))}.two-col{grid-template-columns:1fr}.content{padding:22px}.topbar{padding:0 22px}.search{min-width:130px}}
@media(max-width:760px){.login-wrap{grid-template-columns:1fr}.hero{display:none}.login-side{padding:28px 22px}.app{grid-template-columns:1fr}.sidebar{position:fixed;z-index:4;top:0;bottom:0;right:-270px;width:250px;transition:right .2s}.sidebar.open{right:0}.mobile-menu{display:inline-flex}.topbar{height:68px;padding:0 15px}.top-title h1{font-size:16px}.top-title p{display:none}.search{display:none}.content{padding:18px 14px}.stats{gap:10px}.stat{padding:14px}.stat strong{font-size:23px}.page-head{align-items:flex-start}.page-head h2{font-size:19px}.page-head .primary{padding:10px;font-size:12px}.panel{padding:14px}.form-grid{grid-template-columns:1fr}.top-actions .secondary{display:none}}
</style>
</head>
<body>
<section id="loginScreen" class="login-wrap">
  <div class="login-side">
    <div class="brand"><div class="logo">✚</div><div><h1>نظام إدارة الصيدلية</h1><p>Pharmacy Management System</p></div></div>
    <h2>مرحباً بعودتك</h2><p class="intro">سجّل الدخول للوصول إلى لوحة التحكم وإدارة الأدوية والمخزون والمبيعات بكل سهولة.</p>
    <form id="loginForm">
      <div class="field"><label for="username">اسم المستخدم</label><input id="username" autocomplete="username" placeholder="أدخل اسم المستخدم" required></div>
      <div class="field"><label for="password">كلمة المرور</label><input id="password" type="password" autocomplete="current-password" placeholder="أدخل كلمة المرور" required></div>
      <button class="primary login-btn" type="submit">تسجيل الدخول　 ←</button><p id="loginError" class="login-error"></p>
    </form>
    <div class="credits">
      <div>تحت إشراف مدير الإمداد الطبي</div><strong>د. أسماء البدري عبدالله</strong><br>
      <div>الفكرة والتنفيذ: <strong>د. أحمد فتحي</strong></div>
      <div>التصميم والتطوير: <strong>أ. أحمد كامل السيد</strong></div>
    </div>
  </div>
  <aside class="hero"><div class="hero-content"><div class="eyebrow">SMART PHARMACY · DIGITAL OPERATIONS</div><h2>إدارة صيدليتك<br>بذكاء وكفاءة</h2><p>منصة موحدة لتنظيم المخزون ومتابعة الصلاحية وتسجيل المبيعات واتخاذ قرارات مبنية على بيانات واضحة.</p><div class="feature-list"><div class="feature"><span>▦</span><span>متابعة دقيقة للمخزون والأصناف</span></div><div class="feature"><span>◷</span><span>تنبيهات للصلاحية ونقص الكميات</span></div><div class="feature"><span>↗</span><span>تقارير تشغيلية واضحة</span></div></div></div><div class="hero-foot">واجهة تجريبية — يلزم إعداد خادم وقاعدة بيانات للاستخدام الفعلي</div></aside>
</section>
<section id="appScreen" class="app hidden">
  <aside class="sidebar" id="sidebar">
    <div class="side-brand"><div class="logo">✚</div><div><h2>إدارة الصيدلية</h2><p>نظام إدارة متكامل</p></div></div>
    <div><div class="nav-label">القائمة الرئيسية</div><nav class="nav" id="nav">
      <button class="active" data-page="dashboard"><span class="ico">▦</span>لوحة التحكم</button>
      <button data-page="inventory"><span class="ico">▤</span>الأدوية والمخزون</button>
      <button data-page="sales"><span class="ico">🛒</span>المبيعات</button>
      <button data-page="suppliers"><span class="ico">♧</span>الموردون</button>
      <button data-page="reports"><span class="ico">▥</span>التقارير</button>
      <button data-page="settings"><span class="ico">⚙</span>الإعدادات</button>
    </nav></div>
    <div class="side-bottom"><div class="user-mini"><div class="avatar">أك</div><div><strong>مدير النظام</strong><small>صلاحية كاملة (نموذج)</small></div></div><button id="logoutBtn" style="width:100%;background:#ffffff12;color:#dbe8ec;margin-top:10px">↪ تسجيل الخروج</button></div>
  </aside>
  <main class="main">
    <header class="topbar"><div style="display:flex;align-items:center;gap:12px"><button class="secondary mobile-menu" id="mobileMenu">☰</button><div class="top-title"><h1 id="topTitle">لوحة التحكم</h1><p id="todayDate"></p></div></div><div class="top-actions"><input id="globalSearch" class="search" placeholder="ابحث عن دواء أو صنف..."><button class="secondary" id="themeBtn" title="تبديل المظهر">◐</button><div class="avatar">أك</div></div></header>
    <div class="content" id="pageContent"></div>
  </main>
</section>
<div id="modalRoot"></div><div id="toastRoot"></div>
<script>
const $=s=>document.querySelector(s);
const money=n=>Number(n||0).toLocaleString('ar-EG',{style:'currency',currency:'EGP',maximumFractionDigits:2});
const today=new Date();
$('#todayDate').textContent=today.toLocaleDateString('ar-EG',{weekday:'long',year:'numeric',month:'long',day:'numeric'});
let products=[
{id:1,name:'باراسيتامول 500 مجم',category:'مسكنات',batch:'PCM-2601',qty:120,min:30,price:18,expiry:'2027-08-15',supplier:'الشركة المتحدة'},
{id:2,name:'فيتامين C 1000 مجم',category:'فيتامينات',batch:'VTC-2512',qty:18,min:25,price:95,expiry:'2026-12-20',supplier:'النيل للأدوية'},
{id:3,name:'أموكسيسيلين 500 مجم',category:'مضادات حيوية',batch:'AMX-2602',qty:42,min:15,price:65,expiry:'2027-04-11',supplier:'الشركة المتحدة'},
{id:4,name:'محلول ملحي 0.9%',category:'مستلزمات',batch:'SAL-2511',qty:9,min:20,price:22,expiry:'2026-11-05',supplier:'المصرية للمستلزمات'},
{id:5,name:'أوميبرازول 20 مجم',category:'الجهاز الهضمي',batch:'OMP-2603',qty:76,min:20,price:34,expiry:'2027-09-01',supplier:'النيل للأدوية'},
{id:6,name:'شراب للسعال',category:'أدوية عامة',batch:'CS-2601',qty:31,min:10,price:28,expiry:'2026-10-25',supplier:'فارما بلس'}
];
let sales=[{id:1001,date:new Date().toISOString().slice(0,10),items:2,total:113},{id:1002,date:new Date().toISOString().slice(0,10),items:1,total:34},{id:1003,date:new Date(Date.now()-86400000).toISOString().slice(0,10),items:3,total:156}];
let suppliers=['الشركة المتحدة','النيل للأدوية','المصرية للمستلزمات','فارما بلس'];
let currentPage='dashboard',dark=false;
const isSoon=d=>{let diff=(new Date(d)-new Date(new Date().toDateString()))/86400000;return diff>=0&&diff<=90};
const isExpired=d=>new Date(d)<new Date(new Date().toDateString());
function toast(msg){$('#toastRoot').innerHTML=`<div class="toast">${msg}</div>`;setTimeout(()=>$('#toastRoot').innerHTML='',2600)}
$('#loginForm').addEventListener('submit',e=>{e.preventDefault();if($('#username').value==='@2050@'&&$('#password').value==='#2050#'){$('#loginScreen').classList.add('hidden');$('#appScreen').classList.remove('hidden');render();}else $('#loginError').textContent='بيانات الدخول غير صحيحة. يرجى المحاولة مرة أخرى.'});
$('#logoutBtn').onclick=()=>{$('#appScreen').classList.add('hidden');$('#loginScreen').classList.remove('hidden');$('#password').value='';$('#loginError').textContent=''};
$('#mobileMenu').onclick=()=>$('#sidebar').classList.toggle('open');
$('#themeBtn').onclick=()=>{dark=!dark;document.body.style.setProperty('--bg',dark?'#111b24':'#f4f7fb');document.body.style.setProperty('--panel',dark?'#182631':'#fff');document.body.style.setProperty('--text',dark?'#e6edf3':'#182230');document.body.style.setProperty('--line',dark?'#2c3d49':'#e4eaf1');document.body.style.setProperty('--muted',dark?'#9fb0bd':'#718096');toast(dark?'تم تفعيل المظهر الداكن':'تم تفعيل المظهر الفاتح')};
$('#nav').addEventListener('click',e=>{let b=e.target.closest('button[data-page]');if(!b)return;currentPage=b.dataset.page;$('#nav').querySelectorAll('button').forEach(x=>x.classList.toggle('active',x===b));$('#sidebar').classList.remove('open');render()});
$('#globalSearch').addEventListener('input',()=>{if(currentPage==='inventory')render()});
function stat(title,value,sub,icon,kind=''){return `<div class="stat"><div class="stat-top"><span>${title}</span><span class="stat-icon">${icon}</span></div><strong>${value}</strong><small class="${kind}">${sub}</small></div>`}
function productTable(items){return `<div class="table-wrap"><table><thead><tr><th>الصنف</th><th>التصنيف</th><th>الكمية</th><th>سعر البيع</th><th>الصلاحية</th><th>الحالة</th><th>إجراء</th></tr></thead><tbody>${items.map(p=>`<tr><td><div class="product-cell"><div class="product-thumb">✚</div><div><strong>${esc(p.name)}</strong><small>تشغيلة: ${esc(p.batch)}</small></div></div></td><td>${esc(p.category)}</td><td>${p.qty}</td><td>${money(p.price)}</td><td>${p.expiry}</td><td>${isExpired(p.expiry)?'<span class="pill bad">منتهي</span>':isSoon(p.expiry)?'<span class="pill warn">قريب الانتهاء</span>':p.qty<=p.min?'<span class="pill warn">مخزون منخفض</span>':'<span class="pill">متاح</span>'}</td><td><button class="secondary" onclick="editProduct(${p.id})">تعديل</button></td></tr>`).join('')}</tbody></table></div>`}
function esc(s){return String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]))}
function dashboard(){let low=products.filter(p=>p.qty<=p.min),expiry=products.filter(p=>isExpired(p.expiry)||isSoon(p.expiry));let total=products.reduce((a,p)=>a+p.qty*p.price,0),todaySales=sales.filter(s=>s.date===new Date().toISOString().slice(0,10)).reduce((a,s)=>a+s.total,0);return `<div class="page-head"><div><h2>نظرة عامة</h2><p>ملخص سريع لحالة الصيدلية ومؤشرات التشغيل.</p></div><button class="primary" onclick="openSale()">＋ تسجيل عملية بيع</button></div><div class="stats">${stat('عدد الأصناف',products.length,'صنف مسجل','▤')}${stat('قيمة المخزون التقديرية',money(total),'وفق أسعار البيع','◈')}${stat('مبيعات اليوم',money(todaySales),'إجمالي العمليات المسجلة','↗')}${stat('أصناف تحتاج متابعة',low.length+expiry.length,'نقص مخزون أو صلاحية','⚠','warn')}</div><div class="two-col"><section class="panel"><div class="panel-head"><div><h3>ملخص المبيعات</h3><p>آخر سبعة أيام — بيانات النموذج</p></div><span class="pill">نظرة أسبوعية</span></div><div class="chart">${[42,67,49,82,58,95,72].map((v,i)=>`<div class="bar-group"><div class="bar" style="height:${v}%"></div><span class="bar-label">${['س','ح','ن','ث','ر','خ','ج'][i]}</span></div>`).join('')}</div></section><section class="panel"><div class="panel-head"><div><h3>تنبيهات المخزون والصلاحية</h3><p>أصناف تحتاج إلى مراجعة</p></div><span class="pill warn">${low.length+expiry.length} تنبيه</span></div><div class="alert-list">${[...low.map(p=>({p,kind:'low'})),...expiry.map(p=>({p,kind:'exp'}))].slice(0,5).map(({p,kind})=>`<div class="alert"><div class="alert-icon ${isExpired(p.expiry)?'red':''}">${kind==='low'?'▤':'◷'}</div><div class="alert-info"><strong>${esc(p.name)}</strong><small>${kind==='low'?`الكمية الحالية ${p.qty} — الحد الأدنى ${p.min}`:`تاريخ الصلاحية ${p.expiry}`}</small></div><span class="pill ${isExpired(p.expiry)?'bad':'warn'}">${isExpired(p.expiry)?'منتهي':kind==='low'?'نقص مخزون':'صلاحية'}</span></div>`).join('')||'<div class="empty">لا توجد تنبيهات حالياً</div>'}</div></section></div><section class="panel"><div class="panel-head"><div><h3>الأدوية المسجلة</h3><p>نظرة مختصرة على قائمة الأصناف</p></div><button class="secondary" onclick="go('inventory')">عرض كل الأصناف ←</button></div>${productTable(products.slice(0,5))}</section>`}
function inventory(){let q=$('#globalSearch').value.toLowerCase();let list=products.filter(p=>(p.name+' '+p.category+' '+p.batch).toLowerCase().includes(q));return `<div class="page-head"><div><h2>الأدوية والمخزون</h2><p>إدارة بيانات الأصناف والكميات والتشغيلات وتواريخ الصلاحية.</p></div><button class="primary" onclick="openProduct()">＋ إضافة صنف</button></div><div class="stats">${stat('إجمالي الأصناف',products.length,'كل الأصناف المسجلة','▤')}${stat('مخزون منخفض',products.filter(p=>p.qty<=p.min).length,'أقل من الحد الأدنى','⚠','warn')}${stat('قريب الانتهاء',products.filter(p=>isSoon(p.expiry)).length,'خلال 90 يوماً','◷','warn')}${stat('منتهي الصلاحية',products.filter(p=>isExpired(p.expiry)).length,'يتطلب إجراءً فورياً','!','bad')}</div><section class="panel"><div class="toolbar"><input id="invSearch" placeholder="بحث بالاسم أو التصنيف أو التشغيلة..." value="${esc($('#globalSearch').value)}" oninput="$('#globalSearch').value=this.value;render()"><select onchange="filterCategory(this.value)"><option value="">كل التصنيفات</option>${[...new Set(products.map(p=>p.category))].map(c=>`<option>${esc(c)}</option>`).join('')}</select><button class="secondary" onclick="exportCSV()">تصدير CSV</button></div>${productTable(list)}</section>`}
function salesPage(){return `<div class="page-head"><div><h2>المبيعات</h2><p>تسجيل ومراجعة العمليات المسجلة في النموذج.</p></div><button class="primary" onclick="openSale()">＋ تسجيل عملية بيع</button></div><div class="stats">${stat('عدد العمليات',sales.length,'عمليات مسجلة','▧')}${stat('إجمالي المبيعات',money(sales.reduce((a,s)=>a+s.total,0)),'إجمالي السجل الحالي','↗')}${stat('عمليات اليوم',sales.filter(s=>s.date===new Date().toISOString().slice(0,10)).length,'بتاريخ اليوم','◷')}${stat('متوسط العملية',money(sales.length?sales.reduce((a,s)=>a+s.total,0)/sales.length:0),'متوسط قيمة البيع','◈')}</div><section class="panel"><div class="panel-head"><h3>سجل المبيعات</h3><button class="secondary" onclick="exportSales()">تصدير CSV</button></div><div class="table-wrap"><table><thead><tr><th>رقم العملية</th><th>التاريخ</th><th>عدد الأصناف</th><th>الإجمالي</th><th>الحالة</th></tr></thead><tbody>${sales.slice().reverse().map(s=>`<tr><td>#${s.id}</td><td>${s.date}</td><td>${s.items}</td><td>${money(s.total)}</td><td><span class="pill">مسجلة</span></td></tr>`).join('')}</tbody></table></div></section>`}
function suppliersPage(){return `<div class="page-head"><div><h2>الموردون</h2><p>قائمة الموردين المسجلين — بيانات تجريبية قابلة للتعديل.</p></div><button class="primary" onclick="addSupplier()">＋ إضافة مورد</button></div><section class="panel"><div class="table-wrap"><table><thead><tr><th>اسم المورد</th><th>الأصناف المرتبطة</th><th>الحالة</th></tr></thead><tbody>${suppliers.map(s=>`<tr><td><div class="product-cell"><div class="product-thumb">♧</div><strong>${esc(s)}</strong></div></td><td>${products.filter(p=>p.supplier===s).length}</td><td><span class="pill">نشط</span></td></tr>`).join('')}</tbody></table></div></section>`}
function reports(){return `<div class="page-head"><div><h2>التقارير</h2><p>ملخصات تشغيلية للمخزون والمبيعات.</p></div></div><div class="stats">${stat('قيمة المخزون',money(products.reduce((a,p)=>a+p.qty*p.price,0)),'قيمة تقديرية','◈')}${stat('إجمالي المبيعات',money(sales.reduce((a,s)=>a+s.total,0)),'كل العمليات المسجلة','↗')}${stat('أصناف منخفضة',products.filter(p=>p.qty<=p.min).length,'تحتاج إعادة طلب','⚠')}${stat('أصناف منتهية',products.filter(p=>isExpired(p.expiry)).length,'تحتاج مراجعة','◷','bad')}</div><div class="two-col"><section class="panel"><div class="panel-head"><h3>تقرير المخزون</h3><button class="secondary" onclick="exportCSV()">تنزيل CSV</button></div><p class="muted">يتضمن التقرير اسم الصنف والتصنيف والكمية والسعر وتاريخ الصلاحية والمورد.</p></section><section class="panel"><div class="panel-head"><h3>تقرير المبيعات</h3><button class="secondary" onclick="exportSales()">تنزيل CSV</button></div><p class="muted">يتضمن التقرير رقم العملية والتاريخ وعدد الأصناف وإجمالي قيمة البيع.</p></section></div>`}
function settings(){return `<div class="page-head"><div><h2>الإعدادات</h2><p>معلومات النظام وإعدادات النموذج التجريبي.</p></div></div><section class="panel"><div class="panel-head"><h3>معلومات التطبيق</h3><span class="pill warn">وضع تجريبي</span></div><div class="form-grid"><div class="field"><label>اسم النظام</label><input value="نظام إدارة الصيدلية" readonly></div><div class="field"><label>الإصدار</label><input value="1.0 Prototype" readonly></div><div class="field"><label>طريقة حفظ البيانات</label><input value="ذاكرة المتصفح — مؤقتة" readonly></div><div class="field"><label>حالة التكامل مع EXE</label><input value="غير متصل — يتطلب فحص البرنامج الأصلي" readonly></div></div><div style="background:#fff7e5;padding:14px;border-radius:12px;color:#865d12;line-height:1.8;font-size:12px">تنبيه: هذا الملف نموذج واجهة يعمل محلياً. لا تستخدمه كسجل صيدلية إنتاجي قبل ربطه بخادم وقاعدة بيانات آمنة، وإضافة صلاحيات المستخدمين وسجل تدقيق ونسخ احتياطي.</div></section><section class="panel" style="margin-top:18px"><div class="panel-head"><h3>الاعتمادات</h3></div><p>تحت إشراف مدير الإمداد الطبي: <strong>د. أسماء البدري عبدالله</strong></p><p>الفكرة والتنفيذ: <strong>د. أحمد فتحي</strong></p><p>التصميم والتطوير: <strong>أ. أحمد كامل السيد</strong></p></section>`}
function render(){const map={dashboard:dashboard,inventory:inventory,sales:salesPage,suppliers:suppliersPage,reports:reports,settings:settings};const titles={dashboard:'لوحة التحكم',inventory:'الأدوية والمخزون',sales:'المبيعات',suppliers:'الموردون',reports:'التقارير',settings:'الإعدادات'};$('#topTitle').textContent=titles[currentPage];$('#pageContent').innerHTML=map[currentPage]()}
function go(page){currentPage=page;$('#nav').querySelectorAll('button').forEach(b=>b.classList.toggle('active',b.dataset.page===page));render()}
function filterCategory(cat){if(!cat){render();return}let all=products;$('#pageContent').innerHTML=`<div class="page-head"><div><h2>الأدوية والمخزون</h2><p>التصنيف: ${esc(cat)}</p></div><button class="primary" onclick="openProduct()">＋ إضافة صنف</button></div><section class="panel">${productTable(all.filter(p=>p.category===cat))}</section>`}
function openProduct(id=null){let p=id?products.find(x=>x.id===id):{name:'',category:'أدوية عامة',batch:'',qty:0,min:10,price:0,expiry:'',supplier:suppliers[0]};$('#modalRoot').innerHTML=`<div class="modal-backdrop" onclick="if(event.target===this)closeModal()"><div class="modal"><div class="modal-head"><h3>${id?'تعديل بيانات الصنف':'إضافة صنف جديد'}</h3><button class="secondary" onclick="closeModal()">✕</button></div><form id="productForm"><div class="form-grid"><div class="field"><label>اسم الدواء / الصنف *</label><input name="name" required value="${esc(p.name)}"></div><div class="field"><label>التصنيف</label><input name="category" required value="${esc(p.category)}"></div><div class="field"><label>رقم التشغيلة</label><input name="batch" value="${esc(p.batch)}"></div><div class="field"><label>المورد</label><select name="supplier">${suppliers.map(s=>`<option ${p.supplier===s?'selected':''}>${esc(s)}</option>`).join('')}</select></div><div class="field"><label>الكمية الحالية *</label><input name="qty" type="number" min="0" required value="${p.qty}"></div><div class="field"><label>الحد الأدنى للمخزون</label><input name="min" type="number" min="0" value="${p.min}"></div><div class="field"><label>سعر البيع بالجنيه *</label><input name="price" type="number" min="0" step=".01" required value="${p.price}"></div><div class="field"><label>تاريخ الصلاحية *</label><input name="expiry" type="date" required value="${p.expiry}"></div></div><div class="modal-actions"><button class="primary" type="submit">حفظ البيانات</button><button class="secondary" type="button" onclick="closeModal()">إلغاء</button></div></form></div></div>`;
$('#productForm').onsubmit=e=>{e.preventDefault();let f=new FormData(e.target),data=Object.fromEntries(f.entries());data.qty=+data.qty;data.min=+data.min;data.price=+data.price;if(id)products=products.map(x=>x.id===id?{...x,...data}:x);else products.push({id:Math.max(0,...products.map(x=>x.id))+1,...data});closeModal();render();toast('تم حفظ بيانات الصنف في النموذج الحالي')}}
function editProduct(id){openProduct(id)}
function closeModal(){$('#modalRoot').innerHTML=''}
function openSale(){$('#modalRoot').innerHTML=`<div class="modal-backdrop" onclick="if(event.target===this)closeModal()"><div class="modal"><div class="modal-head"><h3>تسجيل عملية بيع</h3><button class="secondary" onclick="closeModal()">✕</button></div><form id="saleForm"><div class="field"><label>الصنف *</label><select name="product" required>${products.filter(p=>p.qty>0&&!isExpired(p.expiry)).map(p=>`<option value="${p.id}">${esc(p.name)} — المتاح ${p.qty} — ${money(p.price)}</option>`).join('')}</select></div><div class="field"><label>الكمية *</label><input name="qty" type="number" min="1" value="1" required></div><div class="modal-actions"><button class="primary" type="submit">تأكيد البيع</button><button class="secondary" type="button" onclick="closeModal()">إلغاء</button></div></form></div></div>`;
$('#saleForm').onsubmit=e=>{e.preventDefault();let f=new FormData(e.target),p=products.find(x=>x.id===+f.get('product')),qty=+f.get('qty');if(!p||qty<1||qty>p.qty){toast('الكمية المطلوبة غير متاحة');return}if(isExpired(p.expiry)){toast('لا يمكن بيع صنف منتهي الصلاحية');return}p.qty-=qty;sales.push({id:Math.max(1000,...sales.map(s=>s.id))+1,date:new Date().toISOString().slice(0,10),items:1,total:qty*p.price});closeModal();render();toast('تم تسجيل البيع وتحديث المخزون')}}
function addSupplier(){let name=prompt('أدخل اسم المورد الجديد:');if(name&&name.trim()){suppliers.push(name.trim());render();toast('تمت إضافة المورد في النموذج الحالي')}}
function download(name,content,type='text/csv;charset=utf-8;'){let a=document.createElement('a');a.href=URL.createObjectURL(new Blob(['\ufeff'+content],{type}));a.download=name;a.click();URL.revokeObjectURL(a.href)}
function exportCSV(){let rows=[['الاسم','التصنيف','التشغيلة','الكمية','الحد الأدنى','سعر البيع','الصلاحية','المورد'],...products.map(p=>[p.name,p.category,p.batch,p.qty,p.min,p.price,p.expiry,p.supplier])];download('pharmacy_inventory.csv',rows.map(r=>r.map(v=>'"'+String(v).replace(/"/g,'""')+'"').join(',')).join('\r\n'))}
function exportSales(){let rows=[['رقم العملية','التاريخ','عدد الأصناف','الإجمالي'],...sales.map(s=>[s.id,s.date,s.items,s.total])];download('pharmacy_sales.csv',rows.map(r=>r.join(',')).join('\r\n'))}
</script>
</body>
</html>
